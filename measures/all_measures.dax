// ============================================================================
// IT Helpdesk Analytics — DAX Measures
// ----------------------------------------------------------------------------
// Paste each measure into the _Measures table in Power BI Desktop
// (Home -> Enter Data -> create a blank table named "_Measures"; hide the
// dummy column; then for each measure: Modeling -> New Measure -> paste).
//
// Table naming expected in the model:
//   FactTickets, DimAgent, DimCategory, DimChannel, DimPriority, DimCalendar
//
// Each measure is preceded by a one-line `// business question:` comment so
// non-technical reviewers can read the file end-to-end.
// ============================================================================


-- ============================================================
-- [THEME: Volume]
-- ============================================================

// business question: How many tickets do we have in scope right now (after slicers)?
[Total Tickets] :=
COUNTROWS ( FactTickets )

// business question: How many tickets were OPENED inside the currently-selected date window?
[Tickets Created (period)] :=
CALCULATE (
    COUNTROWS ( FactTickets ),
    USERELATIONSHIP ( FactTickets[created_date_key], DimCalendar[date_key] )
)

// business question: How many tickets were RESOLVED inside the currently-selected window?
[Tickets Resolved (period)] :=
CALCULATE (
    COUNTROWS ( FactTickets ),
    FactTickets[resolved_at] <> BLANK ()
)

// business question: How many tickets are still open right now (Open or Pending)?
[Tickets Open] :=
CALCULATE (
    COUNTROWS ( FactTickets ),
    FactTickets[status] IN { "Open", "Pending" }
)

// business question: How many tickets were created each day (for a sparkline trend visual)?
[Tickets by Day] :=
SUMX (
    VALUES ( DimCalendar[date] ),
    CALCULATE ( COUNTROWS ( FactTickets ) )
)


-- ============================================================
-- [THEME: Efficiency]
-- ============================================================

// business question: On average, how long does it take to RESOLVE a ticket?
[MTTR Hours] :=
AVERAGEX (
    FILTER ( FactTickets, NOT ISBLANK ( FactTickets[resolution_hours] ) ),
    FactTickets[resolution_hours]
)

// business question: Show MTTR in a human-readable "Xh Ym" format for KPI cards.
[MTTR Display] :=
VAR _h = [MTTR Hours]
VAR _whole = INT ( _h )
VAR _mins  = INT ( ( _h - _whole ) * 60 )
RETURN
    IF ( ISBLANK ( _h ), "n/a", _whole & "h " & _mins & "m" )

// business question: On average, how long until an agent makes FIRST contact with the customer?
[MTTA Hours] :=
AVERAGEX (
    FILTER ( FactTickets, NOT ISBLANK ( FactTickets[response_hours] ) ),
    FactTickets[response_hours]
)

// business question: Show MTTA in a human-readable "Xh Ym" format for KPI cards.
[MTTA Display] :=
VAR _h = [MTTA Hours]
VAR _whole = INT ( _h )
VAR _mins  = INT ( ( _h - _whole ) * 60 )
RETURN
    IF ( ISBLANK ( _h ), "n/a", _whole & "h " & _mins & "m" )


-- ============================================================
-- [THEME: FCR  (First Contact Resolution)]
-- ============================================================

// business question: How many tickets were resolved on the first try (never reopened)?
[FCR Count] :=
CALCULATE (
    COUNTROWS ( FactTickets ),
    FactTickets[is_first_contact_resolved] = 1
)

// business question: What share of resolved tickets were one-and-done?
[FCR Rate] :=
DIVIDE ( [FCR Count], [Tickets Resolved (period)], 0 ) * 100

// business question: Show the FCR rate as a percentage for KPI cards.
[FCR Rate Display] :=
FORMAT ( [FCR Rate], "0.0" ) & "%"


-- ============================================================
-- [THEME: SLA]
-- ============================================================

// business question: How many RESOLVED tickets met their SLA target?
[SLA Compliant Count] :=
CALCULATE (
    COUNTROWS ( FactTickets ),
    FactTickets[sla_breached] = 0,
    FactTickets[resolved_at] <> BLANK ()
)

// business question: How many RESOLVED tickets BREACHED their SLA target?
[SLA Breach Count] :=
CALCULATE (
    COUNTROWS ( FactTickets ),
    FactTickets[sla_breached] = 1
)

// business question: What % of resolved tickets met SLA?
[SLA Compliance Rate] :=
DIVIDE ( [SLA Compliant Count], [Tickets Resolved (period)], 0 ) * 100

// business question: Show SLA compliance as a percentage for KPI cards.
[SLA Compliance Display] :=
FORMAT ( [SLA Compliance Rate], "0.0" ) & "%"

// business question: How many OPEN tickets are about to breach (>=80% of SLA target elapsed)?
[SLA At Risk] :=
CALCULATE (
    COUNTROWS ( FactTickets ),
    FILTER (
        FactTickets,
        ISBLANK ( FactTickets[resolved_at] )
            && DATEDIFF ( FactTickets[created_at], NOW (), HOUR )
                >= 0.8 * FactTickets[sla_target_hours]
    )
)

// business question: SLA breach rate by category — for a matrix visual showing weak spots.
[SLA Breach Rate by Category] :=
DIVIDE ( [SLA Breach Count], [Tickets Resolved (period)], 0 ) * 100


-- ============================================================
-- [THEME: Backlog & Aging]
-- ============================================================

// business question: How big is the open ticket backlog right now?
[Backlog Count] :=
CALCULATE (
    COUNTROWS ( FactTickets ),
    ISBLANK ( FactTickets[resolved_at] )
)

// business question: How old (in days) is the OLDEST unresolved ticket?
[Oldest Open Ticket Days] :=
CALCULATE (
    MAXX (
        FILTER ( FactTickets, ISBLANK ( FactTickets[resolved_at] ) ),
        DATEDIFF ( FactTickets[created_at], NOW (), DAY )
    )
)

// business question: How many open tickets are 0-1 day old?
[Tickets in 0-1 Day band] :=
CALCULATE (
    COUNTROWS ( FactTickets ),
    FactTickets[ticket_age_band] = "0-1 Day"
)

// business question: How many open tickets are 1-3 days old?
[Tickets in 1-3 Days band] :=
CALCULATE (
    COUNTROWS ( FactTickets ),
    FactTickets[ticket_age_band] = "1-3 Days"
)

// business question: How many open tickets are 3-7 days old?
[Tickets in 3-7 Days band] :=
CALCULATE (
    COUNTROWS ( FactTickets ),
    FactTickets[ticket_age_band] = "3-7 Days"
)

// business question: How many open tickets are 7+ days old (overdue zone)?
[Tickets in 7+ Days band] :=
CALCULATE (
    COUNTROWS ( FactTickets ),
    FactTickets[ticket_age_band] IN { "7-14 Days", "14+ Days" }
)


-- ============================================================
-- [THEME: Agent Performance]
-- ============================================================

// business question: Average ticket load per agent (workload distribution).
[Tickets per Agent] :=
DIVIDE ( [Total Tickets], DISTINCTCOUNT ( FactTickets[agent_key] ), 0 )

// business question: Average resolution time PER AGENT (used in an agent matrix visual).
[Agent MTTR] :=
AVERAGEX (
    FILTER ( FactTickets, NOT ISBLANK ( FactTickets[resolution_hours] ) ),
    FactTickets[resolution_hours]
)

// business question: First-contact resolution rate PER AGENT (matrix visual).
[Agent FCR Rate] :=
DIVIDE (
    CALCULATE ( COUNTROWS ( FactTickets ), FactTickets[is_first_contact_resolved] = 1 ),
    CALCULATE ( COUNTROWS ( FactTickets ), FactTickets[resolved_at] <> BLANK () ),
    0
) * 100

// business question: SLA compliance rate PER AGENT (matrix visual).
[Agent SLA Compliance] :=
DIVIDE (
    CALCULATE (
        COUNTROWS ( FactTickets ),
        FactTickets[sla_breached] = 0,
        FactTickets[resolved_at] <> BLANK ()
    ),
    CALCULATE ( COUNTROWS ( FactTickets ), FactTickets[resolved_at] <> BLANK () ),
    0
) * 100


-- ============================================================
-- [THEME: CSAT  (satisfaction_score is nullable — every measure guards on BLANK)]
-- ============================================================

// business question: Average customer satisfaction score (1-5 scale).
[Avg CSAT] :=
CALCULATE (
    AVERAGE ( FactTickets[satisfaction_score] ),
    FactTickets[satisfaction_score] <> BLANK ()
)

// business question: Show average CSAT as "X.X / 5.0" for KPI cards.
[CSAT Display] :=
IF ( ISBLANK ( [Avg CSAT] ), "n/a", FORMAT ( [Avg CSAT], "0.0" ) & " / 5.0" )

// business question: What % of rated tickets scored 4 or 5 (satisfied customers)?
[CSAT Satisfied Rate] :=
DIVIDE (
    CALCULATE (
        COUNTROWS ( FactTickets ),
        FactTickets[satisfaction_score] >= 4,
        FactTickets[satisfaction_score] <> BLANK ()
    ),
    CALCULATE (
        COUNTROWS ( FactTickets ),
        FactTickets[satisfaction_score] <> BLANK ()
    ),
    0
) * 100

// business question: What % of rated tickets scored 1 or 2 (dissatisfied customers)?
[CSAT Dissatisfied Rate] :=
DIVIDE (
    CALCULATE (
        COUNTROWS ( FactTickets ),
        FactTickets[satisfaction_score] <= 2,
        FactTickets[satisfaction_score] <> BLANK ()
    ),
    CALCULATE (
        COUNTROWS ( FactTickets ),
        FactTickets[satisfaction_score] <> BLANK ()
    ),
    0
) * 100
